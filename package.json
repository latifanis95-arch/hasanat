    "passages": "node src/cli.ts passages",
    "themes": "node src/cli.ts themes",
    "reciters": "node src/cli.ts reciters",
    "formats": "node src/cli.ts formats",
    "fonds": "node src/cli.ts fonds",
    "phrases": "node src/cli.ts phrases",
    "verset": "node src/cli.ts verset",
    "menage": "node src/cli.ts menage",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "gsap": "3.15.0",
    "hyperframes": "0.8.96"
  },
  "devDependencies": {
    "@types/node": "^24.19.0",
    "typescript": "^5.9.3"
  }
