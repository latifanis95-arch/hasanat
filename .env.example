# Copie ce fichier en .env, puis colle tes clés après le signe « = » (sans espace, sans guillemets).
# Ce fichier .env reste sur ton ordinateur : il n'est jamais envoyé sur GitHub.

# Pixabay (gratuite) : vidéos de nature libres de droits pour les fonds.
# Crée un compte sur https://pixabay.com, puis ta clé s'affiche sur https://pixabay.com/api/docs/ (rubrique « Parameters », champ « key »).
PIXABAY_API_KEY=

# Gemini (gratuite, facultative) : vérifie chaque nouveau plan vidéo (ni personne, ni texte) et accorde l'ambiance à l'image.
# Sans elle, le kit n'utilise que des plans déjà vérifiés. Clé : https://aistudio.google.com/apikey → « Create API key ».
GEMINI_API_KEY=

# Réglages facultatifs
# GEMINI_MODEL=gemini-3.5-flash-lite
# HASANAT_CACHE_MAX_GO=4
# FFMPEG_PATH=
# FFPROBE_PATH=
